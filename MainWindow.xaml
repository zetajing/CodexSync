<Window x:Class="CodexSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodexSync" Height="420" Width="540" MinHeight="380" MinWidth="540"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CodexSync" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Codex 会话冷同步 · WebDAV" Margin="0,3,0,0" Opacity="0.7"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="MVP" VerticalAlignment="Center" Opacity="0.55"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TestButton" Content="测试 WebDAV" Width="112" Height="34" Margin="0,0,8,0"
                    HorizontalContentAlignment="Center" Click="TestButton_Click"/>
            <Button x:Name="PushButton" Grid.Column="1" Content="↑ 上传到 NAS" Width="132" Height="34" Margin="0,0,8,0"
                    HorizontalContentAlignment="Center" Click="PushButton_Click"/>
            <Button x:Name="PullButton" Grid.Column="2" Content="↓ 从 NAS 拉取" Width="132" Height="34"
                    HorizontalContentAlignment="Center" Click="PullButton_Click"/>
        </Grid>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="本机状态" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LocalStatusTextBlock" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="同步说明" FontWeight="SemiBold"/>
                    <TextBlock Text="同步前必须完全关闭 Codex。不会同步 auth.json 和 config.toml。" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="运行日志" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="160" Padding="4,4,4,8" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
